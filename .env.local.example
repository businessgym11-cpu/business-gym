# Supabase 프로젝트 설정 → Project Settings → API에서 값을 복사해 .env.local에 붙여넣으세요.
# 이 값들이 비어있으면 로그인/승인 게이트는 자동으로 비활성화됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role 키. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
# (붙이면 브라우저에 노출됨). 관리자 승인 페이지(app/admin)에서만 서버 코드로 사용.
SUPABASE_SERVICE_ROLE_KEY=

# 배포 도메인. 관리자 승인 시 초대 메일의 링크를 만드는 데 사용.
# 로컬 개발 중에는 http://localhost:3000, 배포 후에는 https://business-gym-sigma.vercel.app 등
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 관리자 페이지(/admin) 접근을 허용할 이메일. 콤마로 여러 개 구분 가능.
ADMIN_EMAILS=likesea85@gmail.com

# n8n "Business Gym - Script Generation" 워크플로우의 Production 웹훅 URL.
# n8n 워크플로우 화면 → Webhook 노드 → Production URL 복사
N8N_GENERATE_SCRIPT_WEBHOOK_URL=

# 위 웹훅의 Header Auth에 등록한 것과 동일한 값 (아무 랜덤 문자열이나 직접 정해서
# n8n Webhook 노드의 Header Auth 자격증명과 여기 둘 다에 동일하게 넣으면 됨).
# Step2 이미지 생성 웹훅도 같은 시크릿을 재사용함.
N8N_WEBHOOK_SECRET=

# n8n "Business Gym - Scene Image Generation" 워크플로우의 Production 웹훅 URL.
# Fal.ai API 키는 n8n의 HTTP Request 노드 Header Auth 자격증명에만 저장 — 여기엔 안 넣음.
N8N_GENERATE_IMAGE_WEBHOOK_URL=

# n8n "Business Gym - Final Video Render" 워크플로우의 Production 웹훅 URL.
# 비동기/폴링 재설계(2026-08-16) 이후: Next.js는 확정된 스토리보드
# { scenes: [{ imageUrl, text }], duration }만 보내고, n8n은 Supabase
# render_jobs에 pending 행을 만든 뒤 { jobId }만 즉시 응답해야 함(Respond to
# Webhook을 워크플로우 앞쪽에 둠). 그 이후 같은 실행 안에서 씬마다
# Kling(이미지→비디오)·ElevenLabs(TTS)를 오케스트레이션하고 Creatomate로
# 최종 조립까지 끝낸 뒤, 해당 render_jobs 행을 video_url과 함께 done으로
# (실패 시 error_message와 함께 error로) 업데이트해야 함 — Vercel의 504
# 게이트웨이 타임아웃이 n8n 실제 렌더링 시간(8분+)보다 짧아서 응답을
# 기다리는 단일 요청/응답 구조로는 못 버틴다는 게 확인됨. 프론트엔드는
# jobId를 받은 뒤 checkRenderStatus()로 render_jobs를 직접 폴링함(추가
# n8n 웹훅 불필요). Fal.ai/ElevenLabs/Creatomate API 키는 전부 n8n 노드
# 자격증명에만 저장 — 여기엔 안 넣음. 같은 N8N_WEBHOOK_SECRET을 재사용함.
N8N_RENDER_VIDEO_WEBHOOK_URL=

# n8n "Business Gym - Trend Benchmark Analysis" 워크플로우의 Production 웹훅 URL.
# /trending 카드의 "벤치마킹 분석하기" 버튼에서 호출 — 제목/설명/조회수/썸네일
# URL을 보내면 n8n이 Gemini로 이미지+텍스트를 분석해 { analysis: string }을
# 즉시 응답함(비동기 아님, 폴링 불필요). 같은 N8N_WEBHOOK_SECRET을 재사용함.
N8N_BENCHMARK_ANALYSIS_WEBHOOK_URL=

# n8n "Business Gym - Trend Live Search" 워크플로우의 Production 웹훅 URL.
# /trending 검색창에 임의 키워드를 입력했을 때 호출 — 큐레이션된 배치 데이터와
# 무관하게 YouTube Data API를 직접 검색해 { results: TrendResult[] }를 즉시
# 응답함(비동기 아님, 폴링 불필요). 같은 N8N_WEBHOOK_SECRET을 재사용함.
N8N_TREND_LIVE_SEARCH_WEBHOOK_URL=
